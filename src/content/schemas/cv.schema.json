{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "role": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
              },
              {
                "type": "string",
                "const": "present"
              }
            ]
          },
          "descriptor": {
            "type": "string",
            "description": "One-line summary of the role."
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Needed only when something links to this bullet.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "text": {
                  "type": "string"
                },
                "figure": {
                  "description": "The figure shown beside this line, and how.",
                  "type": "object",
                  "properties": {
                    "figure": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                      "description": "Id of the figure in figures.json."
                    },
                    "parts": {
                      "description": "Model: building parts to highlight.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    },
                    "drawing": {
                      "description": "Model: drawing (from building.json) to show on the model.",
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "azimuth": {
                      "description": "Model: camera angle around the building, in degrees.",
                      "type": "number"
                    },
                    "elevation": {
                      "description": "Model: camera angle above the horizon, in degrees (15–60).",
                      "type": "number",
                      "minimum": 15,
                      "maximum": 60
                    },
                    "zoom": {
                      "description": "Model: zoom multiplier, e.g. 1.5.",
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "image": {
                      "description": "Gallery: index of the image to show.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "time": {
                      "description": "Video: start time in seconds.",
                      "type": "number",
                      "minimum": 0
                    },
                    "until": {
                      "description": "Video: pause at this time, in seconds.",
                      "type": "number",
                      "minimum": 0
                    },
                    "marker": {
                      "description": "Animation: Lottie marker name to play.",
                      "type": "string"
                    },
                    "region": {
                      "description": "Drawing/image/dynamo: zoom to [x, y, width, height] in % of the figure.",
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      ],
                      "items": false,
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "lines": {
                      "description": "Code: highlight lines [from, to].",
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "figure"
                  ]
                },
                "children": {
                  "default": [],
                  "description": "Sub-bullets: finer points under this bullet, shown indented.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "Needed only when something links to this sub-bullet.",
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      "text": {
                        "type": "string"
                      },
                      "figure": {
                        "description": "The figure shown beside this line, and how.",
                        "type": "object",
                        "properties": {
                          "figure": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                            "description": "Id of the figure in figures.json."
                          },
                          "parts": {
                            "description": "Model: building parts to highlight.",
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                            }
                          },
                          "drawing": {
                            "description": "Model: drawing (from building.json) to show on the model.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                          },
                          "azimuth": {
                            "description": "Model: camera angle around the building, in degrees.",
                            "type": "number"
                          },
                          "elevation": {
                            "description": "Model: camera angle above the horizon, in degrees (15–60).",
                            "type": "number",
                            "minimum": 15,
                            "maximum": 60
                          },
                          "zoom": {
                            "description": "Model: zoom multiplier, e.g. 1.5.",
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "image": {
                            "description": "Gallery: index of the image to show.",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "time": {
                            "description": "Video: start time in seconds.",
                            "type": "number",
                            "minimum": 0
                          },
                          "until": {
                            "description": "Video: pause at this time, in seconds.",
                            "type": "number",
                            "minimum": 0
                          },
                          "marker": {
                            "description": "Animation: Lottie marker name to play.",
                            "type": "string"
                          },
                          "region": {
                            "description": "Drawing/image/dynamo: zoom to [x, y, width, height] in % of the figure.",
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              }
                            ],
                            "items": false,
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "lines": {
                            "description": "Code: highlight lines [from, to].",
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              }
                            ],
                            "items": false,
                            "minItems": 2,
                            "maxItems": 2
                          }
                        },
                        "required": [
                          "figure"
                        ]
                      }
                    },
                    "required": [
                      "text"
                    ]
                  }
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "role",
          "company",
          "location",
          "start",
          "end",
          "descriptor",
          "bullets"
        ]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "degree": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
              },
              {
                "type": "string",
                "const": "present"
              }
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "degree",
          "school",
          "location",
          "start",
          "end"
        ]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "E.g. \"BIM\", \"Computational\", \"Visualisation\"."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Software or skills, e.g. [\"Revit\", \"Dynamo\"]."
          }
        },
        "required": [
          "group",
          "items"
        ]
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "issuer",
          "year"
        ]
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "description": "E.g. \"Native\", \"Fluent\", \"B2\"."
          }
        },
        "required": [
          "name",
          "level"
        ]
      }
    }
  },
  "required": [
    "experience",
    "education",
    "skills",
    "certifications",
    "languages"
  ]
}
