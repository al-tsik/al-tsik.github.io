{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "role": {
          "type": "string",
          "description": "Your role on this project."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "location",
        "year",
        "role",
        "description"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*",
          "description": "The .glb file in public/models/."
        }
      },
      "required": [
        "src"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Label number shown on the model, like ① ② ③."
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "meshNames": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "glTF node names that make up this part. Must match names in the model file."
          },
          "labelPosition": {
            "description": "Where the number label sits, in model coordinates (metres, Y up). Defaults to the centre of the part.",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "dynamoScripts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "graphImage": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "format": "starts_with",
                      "pattern": "^\\/.*"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "caption": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "description": "Screenshot of the node graph, exported from Dynamo."
                },
                "pythonFile": {
                  "description": "Python node source (.py) shown as a code preview.",
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "graphImage"
              ]
            }
          },
          "images": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string"
                }
              },
              "required": [
                "src",
                "alt"
              ]
            }
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "summary",
          "meshNames"
        ]
      }
    }
  },
  "required": [
    "project",
    "model",
    "parts"
  ]
}
