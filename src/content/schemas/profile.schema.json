{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Two or three sentences shown at the top of the CV."
    },
    "contact": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "What is shown, e.g. \"name@example.com\" or \"[Phone]\"."
          },
          "href": {
            "description": "Makes the item a link. Leave out for plain text, such as a city.",
            "type": "string",
            "pattern": "^(mailto:|tel:|https?:\\/\\/)"
          }
        },
        "required": [
          "label"
        ]
      },
      "description": "The contact line under the name, in order."
    },
    "cvPdf": {
      "description": "Downloadable PDF version of the CV.",
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "views": {
      "description": "Role and summary for one view. Anything left out uses the values above.",
      "type": "object",
      "properties": {
        "developer": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        },
        "architect": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "role",
    "summary",
    "contact"
  ]
}
